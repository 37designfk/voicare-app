---
interface Props {
  title: string;
  activeTab?: string;
  showBack?: boolean;
  backHref?: string;
}

const { title, activeTab = 'home', showBack = false, backHref = '/' } = Astro.props;

const tabs = [
  { id: 'home', label: 'ホーム', href: '/', icon: 'home' },
  { id: 'record', label: '録音', href: '/record', icon: 'mic' },
  { id: 'records', label: '記録', href: '/records', icon: 'list' },
  { id: 'patients', label: '利用者', href: '/patients', icon: 'users' },
];
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0D7377" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>{title} | VoiCare</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&family=Noto+Sans+JP:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="manifest" href="/manifest.json" />
</head>
<body class="bg-warm-100 text-gray-800 font-sans antialiased min-h-screen pb-24">
  <!-- ノイズテクスチャオーバーレイ -->
  <div class="fixed inset-0 pointer-events-none z-50 opacity-[0.015]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

  <!-- ヘッダー -->
  <header class="sticky top-0 z-40 bg-warm-100/80 backdrop-blur-xl border-b border-warm-200/60">
    <div class="max-w-lg mx-auto px-4 h-14 flex items-center gap-3">
      {showBack ? (
        <a href={backHref} class="flex items-center gap-1 text-teal-500 hover:text-teal-600 transition-colors -ml-1">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
          <span class="text-sm font-medium">戻る</span>
        </a>
      ) : (
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-500 to-teal-600 flex items-center justify-center shadow-sm">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
            </svg>
          </div>
          <span class="font-display font-bold text-teal-800 text-lg tracking-tight">VoiCare</span>
        </div>
      )}
      <div class="flex-1"></div>
      <h1 class="text-sm font-medium text-warm-500 absolute left-1/2 -translate-x-1/2">{showBack ? title : ''}</h1>
      <button class="w-9 h-9 rounded-xl bg-white/60 flex items-center justify-center shadow-sm border border-warm-200/40 hover:bg-white transition-colors">
        <svg class="w-5 h-5 text-warm-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
        </svg>
      </button>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <main class="max-w-lg mx-auto px-4 py-5 animate-fade-in">
    <slot />
  </main>

  <!-- ボトムナビゲーション -->
  <nav class="fixed bottom-0 inset-x-0 z-40 bg-white/90 backdrop-blur-xl border-t border-warm-200/60 safe-area-bottom">
    <div class="max-w-lg mx-auto flex items-stretch">
      {tabs.map((tab) => (
        <a
          href={tab.href}
          class={`flex-1 flex flex-col items-center justify-center py-2 pt-3 transition-all duration-200
            ${activeTab === tab.id
              ? 'text-teal-500'
              : 'text-warm-400 hover:text-warm-500'
            }`}
        >
          <div class={`relative ${activeTab === tab.id ? '' : ''}`}>
            {activeTab === tab.id && (
              <div class="absolute -inset-2 bg-teal-50 rounded-xl"></div>
            )}
            {tab.icon === 'home' && (
              <svg class="w-6 h-6 relative" fill="none" viewBox="0 0 24 24" stroke-width={activeTab === tab.id ? '2' : '1.5'} stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            )}
            {tab.icon === 'mic' && (
              <svg class="w-6 h-6 relative" fill="none" viewBox="0 0 24 24" stroke-width={activeTab === tab.id ? '2' : '1.5'} stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
              </svg>
            )}
            {tab.icon === 'list' && (
              <svg class="w-6 h-6 relative" fill="none" viewBox="0 0 24 24" stroke-width={activeTab === tab.id ? '2' : '1.5'} stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
              </svg>
            )}
            {tab.icon === 'users' && (
              <svg class="w-6 h-6 relative" fill="none" viewBox="0 0 24 24" stroke-width={activeTab === tab.id ? '2' : '1.5'} stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
              </svg>
            )}
          </div>
          <span class={`text-[10px] mt-1 font-medium ${activeTab === tab.id ? 'text-teal-600' : ''}`}>{tab.label}</span>
        </a>
      ))}
    </div>
  </nav>

  <style is:global>
    .safe-area-bottom {
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    /* スクロールバー */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #C5BDA9; border-radius: 4px; }

    /* タップハイライト無効化 */
    * { -webkit-tap-highlight-color: transparent; }

    /* スムーズスクロール */
    html { scroll-behavior: smooth; }
  </style>
</body>
</html>
