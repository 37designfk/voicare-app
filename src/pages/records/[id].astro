---
import AppLayout from '../../layouts/AppLayout.astro';
import { visitRecords, patients, getStatusColor, getStatusLabel } from '../../data/mock';

export function getStaticPaths() {
  return visitRecords.map(r => ({ params: { id: r.id } }));
}

const base = import.meta.env.BASE_URL;
const { id } = Astro.params;
const record = visitRecords.find(r => r.id === id)!;
const patient = patients.find(p => p.id === record.patientId)!;
---

<AppLayout title={record.patientName} activeTab="records" showBack backHref={`${base}records/`}>
  <!-- ヘッダー情報 -->
  <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 mb-4">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-12 h-12 rounded-xl bg-warm-100 flex items-center justify-center text-2xl">
        {patient.avatar}
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-2">
          <h2 class="font-bold text-teal-800">{record.patientName}</h2>
          <span class={`text-[10px] px-2 py-0.5 rounded-full font-medium ${getStatusColor(record.status)}`}>
            {getStatusLabel(record.status)}
          </span>
        </div>
        <p class="text-xs text-warm-400 mt-0.5">{record.date} {record.time} | {record.duration}</p>
      </div>
    </div>
    <div class="flex gap-2">
      {patient.tags.map(tag => (
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-teal-50 text-teal-600 font-medium">{tag}</span>
      ))}
    </div>
  </div>

  <!-- タブ切り替え -->
  <div class="flex bg-warm-200/40 rounded-xl p-1 mb-4">
    <button id="tab-report" class="tab-btn flex-1 py-2 text-xs font-medium rounded-lg bg-white text-teal-700 shadow-sm transition-all">報告書</button>
    <button id="tab-transcript" class="tab-btn flex-1 py-2 text-xs font-medium rounded-lg text-warm-400 transition-all">文字起こし</button>
    <button id="tab-vitals" class="tab-btn flex-1 py-2 text-xs font-medium rounded-lg text-warm-400 transition-all">バイタル</button>
  </div>

  <!-- 報告書タブ -->
  <div id="panel-report" class="tab-panel space-y-3">
    {record.report && (
      <>
        <!-- S: 主観的情報 -->
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-6 h-6 rounded-md bg-blue-100 flex items-center justify-center">
              <span class="text-xs font-bold text-blue-600">S</span>
            </div>
            <span class="text-xs font-medium text-warm-400">主観的情報</span>
          </div>
          <p class="text-sm leading-relaxed text-gray-700">{record.report.subjective}</p>
        </div>

        <!-- O: 客観的情報 -->
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-6 h-6 rounded-md bg-green-100 flex items-center justify-center">
              <span class="text-xs font-bold text-green-600">O</span>
            </div>
            <span class="text-xs font-medium text-warm-400">客観的情報</span>
          </div>
          <p class="text-sm leading-relaxed text-gray-700">{record.report.objective}</p>
        </div>

        <!-- A: アセスメント -->
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-6 h-6 rounded-md bg-amber-100 flex items-center justify-center">
              <span class="text-xs font-bold text-amber-600">A</span>
            </div>
            <span class="text-xs font-medium text-warm-400">アセスメント</span>
          </div>
          <p class="text-sm leading-relaxed text-gray-700">{record.report.assessment}</p>
        </div>

        <!-- P: 計画 -->
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-6 h-6 rounded-md bg-purple-100 flex items-center justify-center">
              <span class="text-xs font-bold text-purple-600">P</span>
            </div>
            <span class="text-xs font-medium text-warm-400">計画</span>
          </div>
          <p class="text-sm leading-relaxed text-gray-700">{record.report.plan}</p>
        </div>

        <!-- ケア内容 -->
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-4 h-4 text-teal-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs font-medium text-warm-400">実施したケア</span>
          </div>
          <ul class="space-y-2">
            {record.report.careContent.map(item => (
              <li class="flex items-start gap-2 text-sm text-gray-700">
                <div class="w-1.5 h-1.5 rounded-full bg-teal-400 mt-1.5 flex-shrink-0"></div>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- 特記事項 -->
        {record.report.notes && (
          <div class="bg-teal-50/50 rounded-2xl p-4 border border-teal-100">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-teal-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
              </svg>
              <span class="text-xs font-medium text-teal-700">特記事項</span>
            </div>
            <p class="text-sm text-teal-800 leading-relaxed">{record.report.notes}</p>
          </div>
        )}
      </>
    )}

    <!-- アクションボタン -->
    <div class="flex gap-2 pt-2">
      <button class="flex-1 py-3 bg-gradient-to-r from-teal-500 to-teal-600 text-white rounded-xl text-sm font-medium shadow-soft hover:shadow-float transition-shadow">
        承認する
      </button>
      <button class="px-4 py-3 bg-white border border-warm-200/40 text-warm-500 rounded-xl text-sm font-medium hover:bg-warm-50 transition-colors">
        編集
      </button>
      <button class="px-4 py-3 bg-white border border-warm-200/40 text-warm-500 rounded-xl text-sm font-medium hover:bg-warm-50 transition-colors">
        PDF
      </button>
    </div>
  </div>

  <!-- 文字起こしタブ -->
  <div id="panel-transcript" class="tab-panel hidden">
    <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-4 h-4 text-coral-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
        </svg>
        <span class="text-xs font-medium text-warm-400">音声文字起こし</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-warm-100 text-warm-400 ml-auto">{record.audioLength}</span>
      </div>
      <p class="text-sm leading-relaxed text-gray-700 whitespace-pre-wrap">{record.transcript}</p>
    </div>
  </div>

  <!-- バイタルタブ -->
  <div id="panel-vitals" class="tab-panel hidden">
    {record.report && (
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 text-center">
          <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" />
            </svg>
          </div>
          <p class="text-[10px] text-warm-400 font-medium">体温</p>
          <p class="text-xl font-bold text-gray-800 font-mono mt-1">{record.report.vitals.temperature}<span class="text-xs text-warm-400 ml-0.5">℃</span></p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 text-center">
          <div class="w-10 h-10 rounded-xl bg-pink-50 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-pink-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </div>
          <p class="text-[10px] text-warm-400 font-medium">血圧</p>
          <p class="text-xl font-bold text-gray-800 font-mono mt-1">{record.report.vitals.bloodPressure}<span class="text-xs text-warm-400 ml-0.5">mmHg</span></p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 text-center">
          <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
          </div>
          <p class="text-[10px] text-warm-400 font-medium">脈拍</p>
          <p class="text-xl font-bold text-gray-800 font-mono mt-1">{record.report.vitals.pulse}<span class="text-xs text-warm-400 ml-0.5">bpm</span></p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 text-center">
          <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
          </div>
          <p class="text-[10px] text-warm-400 font-medium">SpO2</p>
          <p class="text-xl font-bold text-gray-800 font-mono mt-1">{record.report.vitals.spo2}<span class="text-xs text-warm-400 ml-0.5">%</span></p>
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 text-center col-span-2">
          <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3" />
            </svg>
          </div>
          <p class="text-[10px] text-warm-400 font-medium">呼吸数</p>
          <p class="text-xl font-bold text-gray-800 font-mono mt-1">{record.report.vitals.respiration}<span class="text-xs text-warm-400 ml-0.5">回/分</span></p>
        </div>
      </div>
    )}
  </div>

  <script>
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.id.replace('tab-', '');

        tabs.forEach(t => {
          t.classList.remove('bg-white', 'text-teal-700', 'shadow-sm');
          t.classList.add('text-warm-400');
        });
        tab.classList.add('bg-white', 'text-teal-700', 'shadow-sm');
        tab.classList.remove('text-warm-400');

        panels.forEach(p => p.classList.add('hidden'));
        document.getElementById(`panel-${target}`)?.classList.remove('hidden');
      });
    });
  </script>
</AppLayout>
