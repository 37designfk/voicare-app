---
import AppLayout from '../../layouts/AppLayout.astro';
import { visitRecords, getStatusColor, getStatusLabel, patients } from '../../data/mock';

const grouped = visitRecords.reduce((acc, r) => {
  if (!acc[r.date]) acc[r.date] = [];
  acc[r.date].push(r);
  return acc;
}, {} as Record<string, typeof visitRecords>);

const sortedDates = Object.keys(grouped).sort((a, b) => b.localeCompare(a));

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  const days = ['日', '月', '火', '水', '木', '金', '土'];
  return `${d.getMonth() + 1}月${d.getDate()}日（${days[d.getDay()]}）`;
}
---

<AppLayout title="記録一覧" activeTab="records">
  <div class="mb-5">
    <h2 class="text-xl font-display font-bold text-teal-800">訪問記録</h2>
    <p class="text-sm text-warm-400 mt-1">{visitRecords.length}件の記録</p>
  </div>

  <!-- フィルタータブ -->
  <div class="flex gap-2 mb-5 overflow-x-auto no-scrollbar">
    <button class="px-3 py-1.5 bg-teal-500 text-white rounded-lg text-xs font-medium flex-shrink-0">すべて</button>
    <button class="px-3 py-1.5 bg-white text-warm-400 rounded-lg text-xs font-medium border border-warm-200/40 flex-shrink-0 hover:bg-warm-50 transition-colors">完了</button>
    <button class="px-3 py-1.5 bg-white text-warm-400 rounded-lg text-xs font-medium border border-warm-200/40 flex-shrink-0 hover:bg-warm-50 transition-colors">要確認</button>
    <button class="px-3 py-1.5 bg-white text-warm-400 rounded-lg text-xs font-medium border border-warm-200/40 flex-shrink-0 hover:bg-warm-50 transition-colors">処理中</button>
  </div>

  <!-- 日付別記録 -->
  <div class="space-y-6">
    {sortedDates.map(date => (
      <section>
        <h3 class="text-xs font-medium text-warm-400 mb-2 px-1">{formatDate(date)}</h3>
        <div class="space-y-2">
          {grouped[date].map(record => {
            const patient = patients.find(p => p.id === record.patientId);
            return (
              <a href={`/records/${record.id}`} class="block">
                <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 hover:shadow-soft transition-all">
                  <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-warm-100 flex items-center justify-center text-lg flex-shrink-0">
                      {patient?.avatar}
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="font-medium text-sm text-gray-800">{record.patientName}</span>
                        <span class={`text-[10px] px-2 py-0.5 rounded-full font-medium ${getStatusColor(record.status)}`}>
                          {getStatusLabel(record.status)}
                        </span>
                      </div>
                      <div class="flex items-center gap-3 text-xs text-warm-400">
                        <span class="flex items-center gap-1">
                          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          {record.time}
                        </span>
                        <span>{record.duration}</span>
                        <span class="flex items-center gap-1">
                          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
                          </svg>
                          {record.audioLength}
                        </span>
                      </div>
                      {record.report && (
                        <p class="text-xs text-warm-400 mt-2 line-clamp-2 leading-relaxed">
                          {record.report.assessment.slice(0, 60)}...
                        </p>
                      )}
                    </div>
                    <svg class="w-4 h-4 text-warm-300 flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</AppLayout>
