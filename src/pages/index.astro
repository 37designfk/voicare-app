---
import AppLayout from '../layouts/AppLayout.astro';
import { patients, visitRecords, stats, todaySchedule, getStatusColor, getStatusLabel } from '../data/mock';

const recentRecords = visitRecords.filter(r => r.date === '2026-02-27');
---

<AppLayout title="ダッシュボード" activeTab="home">
  <!-- 挨拶 -->
  <div class="mb-6">
    <p class="text-warm-400 text-sm">2026年2月27日（金）</p>
    <h2 class="text-2xl font-display font-bold text-teal-800 mt-1">おはようございます</h2>
  </div>

  <!-- 統計カード -->
  <div class="grid grid-cols-2 gap-3 mb-6">
    <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-8 h-8 rounded-lg bg-teal-50 flex items-center justify-center">
          <svg class="w-4 h-4 text-teal-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <span class="text-xs text-warm-400 font-medium">今日の訪問</span>
      </div>
      <div class="flex items-end gap-1">
        <span class="text-3xl font-bold text-teal-700 font-mono">{stats.todayCompleted}</span>
        <span class="text-warm-400 text-sm mb-1">/ {stats.todayVisits}</span>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-8 h-8 rounded-lg bg-coral-50 flex items-center justify-center">
          <svg class="w-4 h-4 text-coral-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <span class="text-xs text-warm-400 font-medium">要確認</span>
      </div>
      <div class="flex items-end gap-1">
        <span class="text-3xl font-bold text-coral-500 font-mono">{stats.pendingReports}</span>
        <span class="text-warm-400 text-sm mb-1">件</span>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center">
          <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
        </div>
        <span class="text-xs text-warm-400 font-medium">今月の訪問</span>
      </div>
      <div class="flex items-end gap-1">
        <span class="text-3xl font-bold text-gray-700 font-mono">{stats.monthlyVisits}</span>
        <span class="text-warm-400 text-sm mb-1">件</span>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-8 h-8 rounded-lg bg-purple-50 flex items-center justify-center">
          <svg class="w-4 h-4 text-purple-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
          </svg>
        </div>
        <span class="text-xs text-warm-400 font-medium">担当利用者</span>
      </div>
      <div class="flex items-end gap-1">
        <span class="text-3xl font-bold text-gray-700 font-mono">{stats.activePatients}</span>
        <span class="text-warm-400 text-sm mb-1">名</span>
      </div>
    </div>
  </div>

  <!-- 録音クイックアクション -->
  <a href="/record" class="block mb-6 group">
    <div class="relative bg-gradient-to-br from-teal-500 to-teal-600 rounded-2xl p-5 shadow-float overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full -translate-y-8 translate-x-8"></div>
      <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/5 rounded-full translate-y-6 -translate-x-6"></div>
      <div class="relative flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center backdrop-blur-sm group-hover:scale-105 transition-transform">
          <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
          </svg>
        </div>
        <div>
          <p class="text-white font-bold text-lg">録音して記録作成</p>
          <p class="text-teal-100 text-sm mt-0.5">タップして録音を開始</p>
        </div>
        <svg class="w-5 h-5 text-white/60 ml-auto" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </div>
    </div>
  </a>

  <!-- 今日のスケジュール -->
  <section class="mb-6">
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-display font-bold text-teal-800">今日の訪問</h3>
      <span class="text-xs text-warm-400">{todaySchedule.length}件</span>
    </div>
    <div class="space-y-2">
      {todaySchedule.map((visit, i) => {
        const patient = patients.find(p => p.id === visit.patientId);
        const record = recentRecords.find(r => r.patientId === visit.patientId);
        return (
          <a href={record ? `/records/${record.id}` : '#'} class="block">
            <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 flex items-center gap-3 hover:shadow-soft transition-shadow">
              <div class="w-11 h-11 rounded-xl bg-warm-100 flex items-center justify-center text-xl flex-shrink-0">
                {patient?.avatar}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-sm text-gray-800 truncate">{visit.patientName}</span>
                  {record && (
                    <span class={`text-[10px] px-2 py-0.5 rounded-full font-medium ${getStatusColor(record.status)}`}>
                      {getStatusLabel(record.status)}
                    </span>
                  )}
                </div>
                <p class="text-xs text-warm-400 mt-0.5">{visit.time} | {patient?.condition.split('\u3001')[0]}</p>
              </div>
              <svg class="w-4 h-4 text-warm-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 月次報告書 -->
  <section>
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-display font-bold text-teal-800">月次報告書</h3>
      <a href="/monthly" class="text-xs text-teal-500 font-medium hover:text-teal-600">すべて見る</a>
    </div>
    <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-50 to-teal-100 flex items-center justify-center">
          <svg class="w-5 h-5 text-teal-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-medium text-sm">2026年2月 報告書</p>
          <p class="text-xs text-warm-400 mt-0.5">3名分 | 自動生成済み</p>
        </div>
        <a href="/monthly" class="px-3 py-1.5 bg-teal-50 text-teal-600 rounded-lg text-xs font-medium hover:bg-teal-100 transition-colors">
          確認する
        </a>
      </div>
    </div>
  </section>
</AppLayout>
