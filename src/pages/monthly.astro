---
import AppLayout from '../layouts/AppLayout.astro';
import { monthlyReports, patients } from '../data/mock';
---

<AppLayout title="月次報告書" activeTab="records" showBack backHref="/">
  <div class="mb-5">
    <h2 class="text-xl font-display font-bold text-teal-800">月次報告書</h2>
    <p class="text-sm text-warm-400 mt-1">2026年2月 | {monthlyReports.length}名分</p>
  </div>

  <!-- 月選択 -->
  <div class="flex gap-2 mb-5 overflow-x-auto no-scrollbar">
    <button class="px-3 py-1.5 bg-white text-warm-400 rounded-lg text-xs font-medium border border-warm-200/40 flex-shrink-0">12月</button>
    <button class="px-3 py-1.5 bg-white text-warm-400 rounded-lg text-xs font-medium border border-warm-200/40 flex-shrink-0">1月</button>
    <button class="px-3 py-1.5 bg-teal-500 text-white rounded-lg text-xs font-medium flex-shrink-0">2月</button>
  </div>

  <!-- 報告書一覧 -->
  <div class="space-y-4">
    {monthlyReports.map((report, i) => {
      const patient = patients.find(p => p.id === report.patientId);
      return (
        <div class="bg-white rounded-2xl shadow-card border border-warm-200/30 overflow-hidden"
          style={`animation: slide-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${i * 100}ms both`}>
          <!-- ヘッダー -->
          <div class="p-4 border-b border-warm-100">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-warm-100 flex items-center justify-center text-xl">
                {patient?.avatar}
              </div>
              <div class="flex-1">
                <h3 class="font-bold text-sm text-gray-800">{report.patientName}</h3>
                <p class="text-xs text-warm-400">{report.month} | 訪問{report.visitCount}回</p>
              </div>
              <button class="px-3 py-1.5 bg-teal-50 text-teal-600 rounded-lg text-xs font-medium hover:bg-teal-100 transition-colors flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                PDF
              </button>
            </div>
          </div>

          <!-- 内容 -->
          <div class="p-4 space-y-4">
            <div>
              <h4 class="text-xs font-medium text-teal-600 mb-1.5 flex items-center gap-1.5">
                <div class="w-1.5 h-1.5 rounded-full bg-teal-500"></div>
                経過概要
              </h4>
              <p class="text-sm text-gray-700 leading-relaxed">{report.summary}</p>
            </div>
            <div>
              <h4 class="text-xs font-medium text-amber-600 mb-1.5 flex items-center gap-1.5">
                <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
                状態変化
              </h4>
              <p class="text-sm text-gray-700 leading-relaxed">{report.statusChange}</p>
            </div>
            <div>
              <h4 class="text-xs font-medium text-purple-600 mb-1.5 flex items-center gap-1.5">
                <div class="w-1.5 h-1.5 rounded-full bg-purple-500"></div>
                今後の方針
              </h4>
              <p class="text-sm text-gray-700 leading-relaxed">{report.futurePlan}</p>
            </div>
          </div>

          <!-- フッター -->
          <div class="px-4 py-3 bg-warm-50/50 border-t border-warm-100 flex gap-2">
            <button class="flex-1 py-2 bg-gradient-to-r from-teal-500 to-teal-600 text-white rounded-lg text-xs font-medium shadow-sm">
              承認する
            </button>
            <button class="px-4 py-2 bg-white border border-warm-200/40 text-warm-500 rounded-lg text-xs font-medium">
              編集
            </button>
          </div>
        </div>
      );
    })}
  </div>

  <!-- 一括操作 -->
  <div class="mt-5 flex gap-2">
    <button class="flex-1 py-3 bg-gradient-to-r from-teal-500 to-teal-600 text-white rounded-xl text-sm font-medium shadow-soft flex items-center justify-center gap-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      すべて承認
    </button>
    <button class="px-5 py-3 bg-white border border-warm-200/40 text-warm-500 rounded-xl text-sm font-medium flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
      一括PDF
    </button>
  </div>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</AppLayout>
