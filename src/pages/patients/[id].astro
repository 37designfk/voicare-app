---
import AppLayout from '../../layouts/AppLayout.astro';
import { patients, getPatientRecords, getStatusColor, getStatusLabel } from '../../data/mock';

export function getStaticPaths() {
  return patients.map(p => ({ params: { id: p.id } }));
}

const base = import.meta.env.BASE_URL;
const { id } = Astro.params;
const patient = patients.find(p => p.id === id)!;
const records = getPatientRecords(patient.id);
---

<AppLayout title={patient.name} activeTab="patients" showBack backHref={`${base}patients/`}>
  <!-- プロフィールカード -->
  <div class="bg-white rounded-2xl p-5 shadow-card border border-warm-200/30 mb-4">
    <div class="flex items-center gap-4 mb-4">
      <div class="w-16 h-16 rounded-2xl bg-warm-100 flex items-center justify-center text-3xl">
        {patient.avatar}
      </div>
      <div>
        <h2 class="text-lg font-display font-bold text-teal-800">{patient.name}</h2>
        <p class="text-xs text-warm-400">{patient.nameKana}</p>
        <div class="flex items-center gap-2 mt-1">
          <span class="text-xs text-warm-500">{patient.age}歳 {patient.gender}</span>
          <span class="text-xs px-2 py-0.5 bg-teal-50 text-teal-600 rounded font-medium">{patient.careLevel}</span>
        </div>
      </div>
    </div>

    <div class="space-y-3 pt-3 border-t border-warm-100">
      <div class="flex items-start gap-2">
        <svg class="w-4 h-4 text-warm-300 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        <span class="text-xs text-warm-500">{patient.address}</span>
      </div>
      <div class="flex items-start gap-2">
        <svg class="w-4 h-4 text-warm-300 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
        </svg>
        <span class="text-xs text-warm-500">{patient.hospital} / {patient.doctor} 医師</span>
      </div>
      <div class="flex items-start gap-2">
        <svg class="w-4 h-4 text-warm-300 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.35 3.836c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m8.9-4.414c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0118 18.75h-2.25m-7.5-10.5H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375m-8.25-3l1.5 1.5 3-3.75" />
        </svg>
        <span class="text-xs text-warm-500">{patient.condition}</span>
      </div>
      <div class="flex items-start gap-2">
        <svg class="w-4 h-4 text-warm-300 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
        </svg>
        <span class="text-xs text-warm-500">開始日: {patient.startDate}</span>
      </div>
    </div>

    <div class="flex gap-2 mt-4">
      {patient.tags.map(tag => (
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-teal-50 text-teal-600 font-medium">{tag}</span>
      ))}
    </div>
  </div>

  <!-- 訪問記録 -->
  <section>
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-display font-bold text-teal-800">訪問記録</h3>
      <span class="text-xs text-warm-400">{records.length}件</span>
    </div>
    <div class="space-y-2">
      {records.map(record => (
        <a href={`${base}records/${record.id}/`} class="block">
          <div class="bg-white rounded-2xl p-4 shadow-card border border-warm-200/30 hover:shadow-soft transition-all">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-warm-50 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-warm-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                  <span class="text-sm font-medium text-gray-800">{record.date}</span>
                  <span class={`text-[10px] px-2 py-0.5 rounded-full font-medium ${getStatusColor(record.status)}`}>
                    {getStatusLabel(record.status)}
                  </span>
                </div>
                <p class="text-xs text-warm-400">{record.time} | {record.duration}</p>
              </div>
              <svg class="w-4 h-4 text-warm-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</AppLayout>
